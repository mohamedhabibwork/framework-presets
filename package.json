{
  "name": "@framework/presets",
  "version": "0.2.0",
  "description": "Ready-made provider stacks for applications: replace or disable any part.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/mohamedhabibwork/framework/tree/main/packages/presets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamedhabibwork/framework-presets.git"
  },
  "bugs": {
    "url": "https://github.com/mohamedhabibwork/framework/issues"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
